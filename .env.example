# Скопируйте этот файл в .env.local и заполните нужные значения.
# Подробности и порядок настройки — см. SETUP.md в корне проекта.
# Ничего заполнять не обязательно для локального запуска "как есть" —
# без переменных данные просто хранятся в памяти процесса.

# --- Постоянное хранилище (Postgres) — см. SETUP.md раздел 2 ---
DATABASE_URL=
SESSION_SECRET=

# --- Telegram-бот — см. SETUP.md раздел 3 (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Публичный URL приложения — на Vercel можно не задавать (используется VERCEL_URL).
APP_URL=
# Секрет для защиты cron-роута ежедневного дайджеста (/api/cron/telegram-digest).
CRON_SECRET=

# --- Google Calendar — см. SETUP.md раздел 4 (опционально) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
